##########################################
# Global ignores pour Kotlin Multiplatform
##########################################

# Build directories
/build/
/**/build/

# Gradle
/.gradle/
!/gradle/
/.gradle/
/gradlew
/gradlew.bat

# Kotlin compiler caches
/.kotlin/

# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Local config
local.properties

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db

# macOS .AppleDouble files
.AppleDouble

# Temporary files
*.swp
*.tmp
*.temp

# Capture output
captures/

# Android specific
*.apk
*.ap_
*.dex
*.class
*.aab
navigation.json
.navigation/
obj/

# Google Services JSON
**/google-services.json

# Signing keys
*.jks
*.keystore
*.pem
*.p12
*.key

# Crashlytics
crashlytics-build.properties

# Xcode specific for KMP iOS
*.xcuserstate
DerivedData/
Carthage/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png

# Xcode user-specific data (ignore)
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Keep xcworkspace (needed for CocoaPods)
!*.xcworkspace/
# But ignore user-specific workspace settings
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Keep xcodeproj (needed for build)
!*.xcodeproj/
# Keep shared schemes
!*.xcodeproj/xcshareddata/
!*.xcodeproj/xcshareddata/xcschemes/

# CocoaPods
# Keep Podfile and Podfile.lock (required for reproducible builds)
!iosApp/Podfile
!iosApp/Podfile.lock
# Ignore Pods directory (can be regenerated with pod install)
Pods/

# Swift Package Manager
.build/
*.resolved
Package.resolved

# iOS specific
*.ipa
*.dSYM.zip
*.dSYM

# Provisioning profiles
*.mobileprovision
*.provisionprofile

# Preview Content - keep for SwiftUI previews
!iosApp/iosApp/Preview Content/

